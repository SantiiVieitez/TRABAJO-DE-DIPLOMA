<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>

	<connectionStrings>
		<add name="MiConexionPrincipal"
             connectionString="Data Source=(local)\SQLEXPRESS;Initial Catalog=Ingenieria de Software;Integrated Security=True"
             providerName="System.Data.SqlClient" />

		<add name="AuthDB"
             connectionString="Data Source=(local)\SQLEXPRESS;Initial Catalog=AuthDB;Integrated Security=True"
             providerName="System.Data.SqlClient" />
	</connectionStrings>
	
</configuration>